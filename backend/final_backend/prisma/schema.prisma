generator client{
    provider = "prisma-client-js"
    // output = "../../src/generated"
}

datasource db {
    provider="sqlite"
}

model User{
    user_id Int @id @default(autoincrement())
    username String @unique
    password String
    role String
}

model Item{
    item_id Int @id @default(autoincrement())
    title String
    returned Boolean
    username String
    created DateTime @default(now())
}

